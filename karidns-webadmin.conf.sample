# karidns-webadmin.conf: the configuration of karidns-webadmin (docs/karidns-api.md).
# Lines are `key = value`; `#` starts a comment; a value may be in double quotes.  Durations are a number with an optional unit
# s, m, h, d or w (a bare number is seconds).  Copy this file to /usr/local/etc/karidns/karidns-webadmin.conf and edit it.
# Check it with:  karidns-webadmin --check -c /usr/local/etc/karidns/karidns-webadmin.conf

# --- where it listens ------------------------------------------------------------------------------------------------------------------
# 127.0.0.1:port, [::1]:port or the absolute path of a UNIX socket (mode 0660).  Plain HTTP only on loopback or a socket: TLS is the job of a
# reverse proxy in front (relayd, nginx); or set tls-cert and tls-key and listen on another address.
listen = 127.0.0.1:8053
# tls-cert = /usr/local/etc/karidns/webadmin.crt
# tls-key = /usr/local/etc/karidns/webadmin.key      # the service user's, mode 0600 (--check refuses any other)
# The origin a browser sees.  An unsafe request that carries a cookie must send exactly this Origin.
public-origin = https://dns.example.test
# The addresses of the reverse proxies (`local` for a proxy on the UNIX socket of `listen`); only from them is X-Forwarded-For believed (the rate limits and the log use the client's address).
# trusted-proxy = 127.0.0.1, ::1

# --- the database (one of the two) -----------------------------------------------------------------------------------------------------
database = pg
# PostgreSQL: connection files (regular files owned by the user the service runs as, mode 0600 or 0400).  Example content:
#   host=db.example.test port=5432 dbname=karidns user=karidns_api password=... sslmode=verify-full
# api-conninfo-file: the role karidns_api (db/karidns_api_role.pgsql.sql: row level security on).
# check-conninfo-file: the check role (db/karidns_check_role.pgsql.sql); it reads a whole zone for the export.
api-conninfo-file = /usr/local/etc/karidns/api.conninfo
check-conninfo-file = /usr/local/etc/karidns/check.conninfo
# A dataset is a schema with the zone tables; without a section there is one dataset, main, in the schema public.
# [dataset main]
# schema = public
# views = internal, external

# SQLite3 instead (database = sqlite3): the zone file and the auth file (db/karidns_auth.sqlite3.sql, owner = the service user, mode 0600).
# database = sqlite3
# sqlite-file = /var/db/karidns/zones.sqlite3
# auth-file = /var/db/karidns/auth.sqlite3

# --- the programs ------------------------------------------------------------------------------------------------------------------------
# karidns-zone = /usr/local/bin/karidns-zone
# karicheck = /usr/local/bin/karicheck
# The pool of tool runs (karidns-zone, karictl): at most this many at a time, 64 more may wait (default: the CPUs, at most 4).
# workers = 4

# --- reloading after a change -------------------------------------------------------------------------------------------------------------
# A change set asks for a reload when it says "reload": true; this makes that the default.  PostgreSQL: a row in karidns_reload_requests (every server
# reloads the zone).  SQLite3: karictl with a RESTRICTED control key (read-only yes, allow-commands { reload-zone; } in the control channel of karidns.conf):
# karictl-config is its karictl.conf (owner = the service user, mode 0600).  A zone the signer keeps signed is never reloaded by the API.
# reload-after-change = no
# karictl = /usr/local/bin/karictl
# karictl-config = /usr/local/etc/karidns/webadmin-karictl.conf

# --- logins ------------------------------------------------------------------------------------------------------------------------------
# Who must use TOTP: global (every global master; the default), all, none.
# require-totp = global
# session-idle = 30m
# session-max = 12h
# The AES key that wraps the TOTP secrets in the database (64 hex digits, mode 0600); made at the first start.  Keep it with the backups.
# totp-key-file = /var/db/karidns-webadmin/totp.key
# Login attempts a minute (per address and per user name); requests a second and writes a second (per principal).
# rate-login = 5
# rate-api = 20
# rate-write = 2
# Sign-ins one client address may start with an OpenID Connect provider in 10 minutes (1 to 1000; at most 1000 wait in all).
# rate-oidc-start = 20
# The cost of a new password hash, 2^n (14 to 20, default 17: about 128 MiB each, two at a time).
# scrypt-ln = 17
# Days the audit log is kept (7 to 36500); the service deletes older rows every hour.  0 (the default) keeps it for ever.  PostgreSQL: needs the 0.6.1
# karidns_ext.pgsql.sql applied again and karidns_api_role.pgsql.sql run again (the function karidns_auth.prune_audit).
# audit-retention = 0

# --- the web interface -------------------------------------------------------------------------------------------------------------------
# The files of the web interface are read once at the start and served under / and /ui/ (no login is needed for them).  `no` serves only /api/v1/.
# ui = yes
# ui-dir = /usr/local/libexec/karidns-webadmin/webadmin/ui

# stderr, or a syslog facility (daemon, local0 ... local7, ...).
log = daemon

# --- sign in with an identity provider (OpenID Connect) ----------------------------------------------------------------------------------
# One section for each provider, at the END of the file (every key after a section header belongs to it).  Register the service at the provider with
# the redirect URI <public-origin>/api/v1/auth/oidc/<name>/callback; the provider must sign ID tokens with RS256, ES256 or EdDSA.  A global master then
# links each user to an identity in the web interface (Administration, the user).  The service makes outbound HTTPS requests to the provider.
# issuer: exactly as in the provider's discovery document (https; http only for a provider on this machine).  client-secret-file: the service user's, mode 0600, one line.
# label: the text of the button.  scopes: default openid.  mfa: totp (the default: require-totp applies to these sign-ins too) or idp (the provider's
# second factor, shown by the amr claim of the ID token, replaces the TOTP step).
# [oidc corp]
# issuer = https://idp.example.test/realms/corp
# client-id = karidns-webadmin
# client-secret-file = /usr/local/etc/karidns/oidc-corp.secret
# label = Corp ID
# scopes = openid
# mfa = totp

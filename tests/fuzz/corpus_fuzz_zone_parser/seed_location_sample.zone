; ============================================================================
; 2. $LOCATION による送信元IP別応答スプリット例
; ============================================================================

; [A] Google Public DNS (8.8.8.8 等) からの問い合わせに対する専用応答
$LOCATION google
resolver-check  IN A     192.0.2.88
resolver-check  IN AAAA  2001:db8::8888
resolver-check  IN TXT   "You are querying via Google Public DNS (8.8.8.8 / Google Geofeed Range)"

www             IN A     192.0.2.188
www             IN AAAA  2001:db8::188
www             IN TXT   "Optimized edge for Google Public DNS users"

; [B] 社内・プライベートIP (10.0.0.0/8, 192.168.0.0/16, 127.0.0.1 等) からの応答
$LOCATION internal
resolver-check  IN A     10.0.0.1
resolver-check  IN TXT   "Internal Private Access"

www             IN A     10.0.0.10
www             IN TXT   "Internal Direct Intranet Endpoint"

; [C] デフォルト (上記にマッチしない一般インターネットクライアント)
$LOCATION ""
resolver-check  IN A     192.0.2.100
resolver-check  IN AAAA  2001:db8::100
resolver-check  IN TXT   "Standard Public Internet Resolver"

www             IN A     192.0.2.10
www             IN AAAA  2001:db8::10
www             IN TXT   "Standard Public Anycast Frontend"

; ============================================================================
; 3. $ECS-SUBNET によるEDNS Client Subnet別応答スプリット例
; ============================================================================

; [A] Google ECS サブネットを伴うクエリに対する応答
$ECS-SUBNET google-ecs
cdn             IN A     192.0.2.201
cdn             IN TXT   "CDN Endpoint: Geotargeted for Google ECS Subnet"

; [B] パートナーネットワーク ECS サブネットを伴うクエリに対する応答
$ECS-SUBNET partner
cdn             IN A     192.0.2.202
cdn             IN TXT   "CDN Endpoint: Partner Fast-Path"

; [C] ECS指定なし、または一般サブネットに対するデフォルト応答
$ECS-SUBNET ""
cdn             IN A     192.0.2.200
cdn             IN TXT   "CDN Endpoint: Global Default Anycast"

; ============================================================================
; 4. $LOCATION と $ECS-SUBNET の複合利用 (Coexistence) 例
; ============================================================================
; 送信元が内部管理ホスト かつ ECSが指定されない場合の管理用エントリ
$LOCATION internal
$ECS-SUBNET ""
api             IN A     10.10.10.1
api             IN TXT   "API internal admin endpoint"

; 一般公開用エントリ
$LOCATION ""
$ECS-SUBNET ""
api             IN A     192.0.2.50
api             IN TXT   "API public gateway"

; ----------------------------------------------------------------------------
; 共通リソースレコード
; ----------------------------------------------------------------------------
mail            IN A     192.0.2.20
mail            IN MX    10 mail.example.com.
@               IN TXT   "v=spf1 mx -all"

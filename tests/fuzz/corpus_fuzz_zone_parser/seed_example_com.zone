$TTL 3600
@   IN  SOA ns1.example.com. hostmaster.example.com. (
            2026090401 ; serial
            3600       ; refresh
            600        ; retry
            604800     ; expire
            300        ; minimum
        )
@       IN  NS      ns1.example.com.
@       IN  A       192.0.2.1
ns1     IN  A       192.0.2.2
www     IN  A       192.0.2.10
www     IN  AAAA    2001:db8::10
mail    IN  MX  10  mail.example.com.
mail    IN  A       192.0.2.20
txtrec  IN  TXT     "v=spf1 -all"

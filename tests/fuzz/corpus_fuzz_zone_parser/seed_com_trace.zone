$TTL 86400
$ORIGIN com.
@       IN SOA  a.gtld-servers.net. hostmaster.gtld-servers.net. (
                2026082401 ; Serial
                3600       ; Refresh
                1800       ; Retry
                604800     ; Expire
                86400      ; Minimum TTL
        )
        IN NS   a.gtld-servers.net.
a.gtld-servers.net. IN A 127.0.0.1

example.com. IN NS ns1.example.com.
ns1.example.com. IN A 127.0.0.1

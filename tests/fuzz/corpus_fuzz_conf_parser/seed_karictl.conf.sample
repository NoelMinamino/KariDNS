// karictl.conf.sample
//
// KariDNS コントロールチャネルクライアント (karictl) 用の設定ファイル
// デフォルトでは /usr/local/etc/karidns/karictl.conf が読み込まれます。
// -f オプションで別のパス、-s オプションで別のUNIXドメインソケットパスを指定することも可能です。
//
// コントロールソケットのパスを変更する場合:
// socket "/var/run/karidns/control.sock";

key "karictl" {
    algorithm "hmac-sha256";
    // サーバー側の control-channel { secret "..."; } と同じ Base64 文字列を指定してください。
    secret "BASE64_ENCODED_SECRET_HERE=";
};

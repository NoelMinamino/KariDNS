        { "fn": "rr_ok", "schema": "s1", "zone": "example.test", "name": "*.example.test", "type": "A", "ttl": 300, "expect": true },
        { "fn": "rr_ok", "schema": "s1", "zone": "example.test", "name": "example.test", "type": "DNSKEY", "ttl": 300, "expect": false },
        { "fn": "rr_ok", "schema": "s1", "zone": "example.test", "name": "example.test", "type": "TYPE48", "ttl": 300, "expect": false },
        { "fn": "rr_ok", "schema": "s1", "zone": "example.test", "name": "www.example.test", "type": "CDS", "ttl": 300, "expect": false },
        { "fn": "rr_ok", "schema": "s1", "zone": "example.test", "name": "www.example.test", "type": "PTR", "ttl": 300, "expect": false },
        { "fn": "rr_ok", "schema": "s1", "zone": "example.test", "name": "evilexample.test", "type": "A", "ttl": 300, "expect": false },
        { "fn": "rr_ok", "schema": "s1", "zone": "example.test", "name": "empty.example.test", "type": "", "ttl": null, "expect": true },
        { "fn": "rr_visible", "schema": "zzz", "zone": "other.test", "name": "www.other.test", "type": "A", "expect": true },
        { "fn": "rr_visible", "schema": "zzz", "zone": "other.test", "name": "www.example.test", "type": "A", "expect": false },
        { "fn": "rr_visible", "schema": "zzz", "zone": "", "name": "www.other.test", "type": "A", "expect": false },
        { "fn": "zone_grant", "schema": "anything", "zone": "any.test", "expect": "global_master" },
        { "fn": "is_global", "expect": true }
      ]
    },
    {
      "name": "a global master with the web policy: the policy still applies to records",
      "grants": [ { "to": "u", "role": "global_master", "schema": null, "zone": null, "suffix": null, "policy": "web" } ],
      "checks": [
        { "fn": "rr_ok", "schema": "s1", "zone": "example.test", "name": "www.example.test", "type": "A", "ttl": 300, "expect": true },
        { "fn": "rr_ok", "schema": "s1", "zone": "example.test", "name": "example.test", "type": "SOA", "ttl": 300, "expect": false },
        { "fn": "rr_ok", "schema": "s1", "zone": "example.test", "name": "example.test", "type": "A", "ttl": 300, "expect": false },
        { "fn": "rr_ok", "schema": "s1", "zone": "example.test", "name": "www.example.test", "type": "MX", "ttl": 300, "expect": false },
        { "fn": "rr_ok", "schema": "s1", "zone": "example.test", "name": "www.example.test", "type": "A", "ttl": 1, "expect": false }
      ]
    },
    {
      "name": "the flags of a policy: delegation, DNAME, apex",
      "grants": [

        { "fn": "rr_ok", "schema": "s1", "zone": "apex.test", "name": "apex.test", "type": "A", "ttl": 300, "expect": true },
        { "fn": "rr_ok", "schema": "s1", "zone": "apex.test", "name": "apex.test", "type": "SOA", "ttl": 300, "expect": false },
        { "fn": "rr_ok", "schema": "s1", "zone": "apex.test", "name": "x.apex.test", "type": "NS", "ttl": 300, "expect": false },
        { "fn": "rr_ok", "schema": "s1", "zone": "apex.test", "name": "apex.test", "type": null, "ttl": null, "expect": false }

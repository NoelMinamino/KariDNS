      "grants": [ { "to": "u", "role": "global_master", "schema": null, "zone": null, "suffix": null, "policy": "all" } ],
      "checks": [
        { "fn": "rr_ok", "schema": "zzz", "zone": "other.test", "name": "www.other.test", "type": "A", "ttl": 300, "expect": true },
        { "fn": "rr_ok", "schema": "s1", "zone": "example.test", "name": "example.test", "type": "SOA", "ttl": 300, "expect": true },
        { "fn": "rr_ok", "schema": "s1", "zone": "example.test", "name": "example.test", "type": "TYPE6", "ttl": 300, "expect": true },
        { "fn": "rr_ok", "schema": "s1", "zone": "example.test", "name": "www.example.test", "type": "SOA", "ttl": 300, "expect": false },
        { "fn": "rr_ok", "schema": "s1", "zone": "example.test", "name": "example.test", "type": "NS", "ttl": 300, "expect": true },

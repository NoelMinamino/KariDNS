{
  "_doc": "Test vectors of the permission rules: one rule set, two implementations. webadmin/lib/perm.js (the API; the only one on SQLite3) and the SQL functions karidns_auth.rr_ok / rr_visible / zone_grant / is_global / policy_subset / may_grant (db/karidns_ext.pgsql.sql). webadmin/test/perm.test.js runs every check against perm.js, tests/run_webadmin_pg_test.sh against the SQL functions in a private transaction that is rolled back. A case makes the user 'u', groups (members: the names of users or groups), grants (to: a name) and says what each check must answer. Names are canonical (lower case, no final dot). A change of a rule is a change here too.",
  "policies": {
    "all":     { "allowed_types": ["A", "AAAA", "CNAME", "DNAME", "MX", "NS", "SOA", "SRV", "TXT"], "allow_wildcard": true,  "allow_delegation": true,  "allow_dname": true,  "apex_editable": true,  "ttl_min": 0,  "ttl_max": 2147483647, "max_rr": null },
    "web":     { "allowed_types": ["A", "AAAA", "CNAME", "TXT"],                                    "allow_wildcard": false, "allow_delegation": false, "allow_dname": false, "apex_editable": false, "ttl_min": 60, "ttl_max": 86400,      "max_rr": 100 },
    "web50":   { "allowed_types": ["A", "AAAA", "CNAME", "TXT"],                                    "allow_wildcard": false, "allow_delegation": false, "allow_dname": false, "apex_editable": false, "ttl_min": 60, "ttl_max": 86400,      "max_rr": 50 },
    "wide":    { "allowed_types": ["A", "AAAA", "CNAME", "TXT"],                                    "allow_wildcard": false, "allow_delegation": false, "allow_dname": false, "apex_editable": false, "ttl_min": 0,  "ttl_max": 86400,      "max_rr": 100 },
    "nsok":    { "allowed_types": ["A", "NS"],                                                      "allow_wildcard": false, "allow_delegation": true,  "allow_dname": false, "apex_editable": false, "ttl_min": 0,  "ttl_max": 2147483647, "max_rr": null },
    "apexpol": { "allowed_types": ["A", "NS", "SOA"],                                               "allow_wildcard": false, "allow_delegation": false, "allow_dname": false, "apex_editable": true,  "ttl_min": 0,  "ttl_max": 2147483647, "max_rr": null },
    "dn":      { "allowed_types": ["DNAME", "A"],                                                   "allow_wildcard": false, "allow_delegation": false, "allow_dname": true,  "apex_editable": false, "ttl_min": 0,  "ttl_max": 2147483647, "max_rr": null },
    "none":    { "allowed_types": [],                                                               "allow_wildcard": false, "allow_delegation": false, "allow_dname": false, "apex_editable": false, "ttl_min": 60, "ttl_max": 86400,      "max_rr": 10 }
  },
  "cases": [

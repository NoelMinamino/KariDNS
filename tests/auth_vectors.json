        { "fn": "rr_ok", "schema": "s1", "zone": "example.test", "name": "example.test", "type": "A", "ttl": 300, "expect": false },
        { "fn": "rr_ok", "schema": "s1", "zone": "example.test", "name": "www.example.test", "type": "A", "ttl": 300, "expect": false },
        { "fn": "rr_ok", "schema": "s1", "zone": "example.test", "name": "a.sub.example.test", "type": "MX", "ttl": 300, "expect": false },
        { "fn": "rr_ok", "schema": "s1", "zone": "example.test", "name": "*.sub.example.test", "type": "A", "ttl": 300, "expect": false },
        { "fn": "rr_ok", "schema": "s1", "zone": "example.test", "name": "empty.sub.example.test", "type": null, "ttl": null, "expect": true },
        { "fn": "rr_visible", "schema": "s1", "zone": "example.test", "name": "sub.example.test", "type": "A", "expect": true },
        { "fn": "rr_visible", "schema": "s1", "zone": "example.test", "name": "a.sub.example.test", "type": "TXT", "expect": true },
        { "fn": "rr_visible", "schema": "s1", "zone": "example.test", "name": "evilsub.example.test", "type": "A", "expect": false },
        { "fn": "rr_visible", "schema": "s1", "zone": "example.test", "name": "www.example.test", "type": "A", "expect": false },
        { "fn": "rr_visible", "schema": "s1", "zone": "example.test", "name": "example.test", "type": "SOA", "expect": true },
        { "fn": "rr_visible", "schema": "s1", "zone": "example.test", "name": "example.test", "type": "NS", "expect": true },
        { "fn": "rr_visible", "schema": "s1", "zone": "example.test", "name": "example.test", "type": "TYPE2", "expect": true },
        { "fn": "rr_visible", "schema": "s1", "zone": "example.test", "name": "example.test", "type": "MX", "expect": false },
        { "fn": "rr_visible", "schema": "s1", "zone": "example.test", "name": "example.test", "type": "A", "expect": false },
        { "fn": "zone_grant", "schema": "s1", "zone": "example.test", "expect": "subdomain_master" },
        { "fn": "is_global", "expect": false }
      ]
    },
    {

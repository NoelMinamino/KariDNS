        { "fn": "rr_ok", "schema": "s1", "zone": "example.test", "name": "WWW.Example.TEST", "type": "a", "ttl": 300, "expect": true },
        { "fn": "rr_ok", "schema": "s1", "zone": "Example.Test", "name": "deep.er.www.example.test", "type": "TXT", "ttl": 60, "expect": true },
        { "fn": "rr_ok", "schema": "s1", "zone": "example.test", "name": "www.example.test", "type": "A", "ttl": 86400, "expect": true },
        { "fn": "rr_ok", "schema": "s1", "zone": "example.test", "name": "example.test", "type": "A", "ttl": 300, "expect": false },
        { "fn": "rr_ok", "schema": "s1", "zone": "example.test", "name": "www.example.test", "type": "A", "ttl": 59, "expect": false },
        { "fn": "rr_ok", "schema": "s1", "zone": "example.test", "name": "www.example.test", "type": "A", "ttl": 86401, "expect": false },
        { "fn": "rr_ok", "schema": "s1", "zone": "example.test", "name": "www.example.test", "type": "A", "ttl": null, "expect": false },
        { "fn": "rr_ok", "schema": "s1", "zone": "example.test", "name": "www.example.test", "type": "MX", "ttl": 300, "expect": false },
        { "fn": "rr_ok", "schema": "s1", "zone": "example.test", "name": "www.example.test", "type": "NS", "ttl": 300, "expect": false },
        { "fn": "rr_ok", "schema": "s1", "zone": "example.test", "name": "www.example.test", "type": "RRSIG", "ttl": 300, "expect": false },
        { "fn": "rr_ok", "schema": "s1", "zone": "example.test", "name": "www.example.test", "type": "TYPE46", "ttl": 300, "expect": false },
        { "fn": "rr_ok", "schema": "s1", "zone": "example.test", "name": "www.example.test", "type": "NSEC3", "ttl": 300, "expect": false },
        { "fn": "rr_ok", "schema": "s1", "zone": "example.test", "name": "evilexample.test", "type": "A", "ttl": 300, "expect": false },
        { "fn": "rr_ok", "schema": "s1", "zone": "example.test", "name": "www.example.test.evil.test", "type": "A", "ttl": 300, "expect": false },
        { "fn": "rr_ok", "schema": "s1", "zone": "example.test", "name": "*.example.test", "type": "A", "ttl": 300, "expect": false },
        { "fn": "rr_ok", "schema": "s1", "zone": "example.test", "name": "a.*.example.test", "type": "A", "ttl": 300, "expect": false },
        { "fn": "rr_ok", "schema": "s1", "zone": "example.test", "name": "b*.example.test", "type": "A", "ttl": 300, "expect": true },
        { "fn": "rr_ok", "schema": "s1", "zone": "example.test", "name": "empty.example.test", "type": null, "ttl": null, "expect": true },
        { "fn": "rr_ok", "schema": "s1", "zone": "example.test", "name": "example.test", "type": null, "ttl": null, "expect": false },
        { "fn": "rr_ok", "schema": "s1", "zone": "example.test", "name": "*.example.test", "type": null, "ttl": null, "expect": false },
        { "fn": "rr_ok", "schema": "s1", "zone": "other.test", "name": "www.other.test", "type": "A", "ttl": 300, "expect": false },
        { "fn": "rr_ok", "schema": "s2", "zone": "example.test", "name": "www.example.test", "type": "A", "ttl": 300, "expect": false },
        { "fn": "rr_ok", "schema": "s1", "zone": "", "name": "www.example.test", "type": "A", "ttl": 300, "expect": false },
        { "fn": "rr_ok", "schema": "s1", "zone": "example.test", "name": "", "type": "A", "ttl": 300, "expect": false },
        { "fn": "rr_visible", "schema": "s1", "zone": "example.test", "name": "www.example.test", "type": "A", "expect": true },
        { "fn": "rr_visible", "schema": "s1", "zone": "example.test", "name": "example.test", "type": "MX", "expect": true },
        { "fn": "rr_visible", "schema": "s1", "zone": "example.test", "name": "example.test", "type": "SOA", "expect": true },
        { "fn": "rr_visible", "schema": "s1", "zone": "example.test", "name": "evilexample.test", "type": "A", "expect": false },
        { "fn": "rr_visible", "schema": "s1", "zone": "example.test", "name": "www.other.test", "type": "A", "expect": false },
        { "fn": "rr_visible", "schema": "s2", "zone": "example.test", "name": "www.example.test", "type": "A", "expect": false },
        { "fn": "rr_visible", "schema": "s1", "zone": "", "name": "www.example.test", "type": "A", "expect": false },
        { "fn": "zone_grant", "schema": "s1", "zone": "example.test", "expect": "domain_master" },
        { "fn": "zone_grant", "schema": "s1", "zone": "EXAMPLE.test", "expect": "domain_master" },
        { "fn": "zone_grant", "schema": "s1", "zone": "other.test", "expect": null },
        { "fn": "zone_grant", "schema": "s2", "zone": "example.test", "expect": null },
        { "fn": "is_global", "expect": false }
      ]
    },
    {
      "name": "a subdomain master: the label boundary, and what it may read",
      "grants": [ { "to": "u", "role": "subdomain_master", "schema": "s1", "zone": "example.test", "suffix": "sub.example.test", "policy": "web" } ],
      "checks": [
        { "fn": "rr_ok", "schema": "s1", "zone": "example.test", "name": "sub.example.test", "type": "A", "ttl": 300, "expect": true },
        { "fn": "rr_ok", "schema": "s1", "zone": "example.test", "name": "a.sub.example.test", "type": "A", "ttl": 300, "expect": true },
        { "fn": "rr_ok", "schema": "s1", "zone": "example.test", "name": "b.a.sub.example.test", "type": "TXT", "ttl": 300, "expect": true },
        { "fn": "rr_ok", "schema": "s1", "zone": "example.test", "name": "evilsub.example.test", "type": "A", "ttl": 300, "expect": false },
        { "fn": "rr_ok", "schema": "s1", "zone": "example.test", "name": "xsub.example.test", "type": "A", "ttl": 300, "expect": false },

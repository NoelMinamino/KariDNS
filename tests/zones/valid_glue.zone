$ORIGIN valid.example.
$TTL 3600
@ IN SOA ns1.valid.example. hostmaster.valid.example. (
    2026082301 ; serial
    7200       ; refresh
    3600       ; retry
    1209600    ; expire
    3600       ; minimum
)
@ IN NS ns1.valid.example.
@ IN NS ns2.external.com.
ns1 IN A 192.0.2.1
ns1 IN AAAA 2001:db8::1
www IN A 192.0.2.10

$ORIGIN example.com.
$TTL 3600
@ IN SOA ns1.example.com. hostmaster.example.com. (
    2026091101 ; serial
    7200       ; refresh
    3600       ; retry
    1209600    ; expire
    3600       ; minimum
)
@ IN NS ns1.example.com.
ns1.example.com. IN A 192.0.2.1

; Out-of-bailiwick glue record in zone file
ns1.example.net. IN A 192.0.2.3

; ============================================================================
; Sample BIND zone file for example.com
;
; KariDNSが対応している全てのリソースレコード(RR)を網羅的に記載した
; サンプルゾーンファイルです。
;
; [構成と特徴]
; 1. 標準/コアレコード (SOA, NS, A, AAAA, CNAME, DNAME, MX, TXT, SPF, SRV,
;    NAPTR, URI, HTTPS, SVCB, CAA, LOC, HINFO, RP, AFSDB, GPOS, NSAP, ISDN, X25, DSYNC)
; 2. 暗号・DNSSECレコード (DNSKEY, DS, CDS, CDNSKEY, CSYNC, ZONEMD, RRSIG,
;    NSEC, NSEC3, NSEC3PARAM, TLSA, SMIMEA, SSHFP, OPENPGPKEY, CERT, IPSECKEY,
;    DHCID, HIP, KEY, TA, DLV)
; 3. ILNP & ルーティング/テレフォニー (NID, L32, L64, LP, APL, EUI48, EUI64,
;    AMTRELAY, WKS, RT, KX, PX, MINFO, NSAP-PTR, AVC)
; 4. 初期メールボックスレコード (MD, MF, MB, MG, MR)
; 5. 実験的/ドラフト/汎用RFC 3597 (NULL/TYPE10, NXT/TYPE30, EID/TYPE31,
;    NIMLOC/TYPE32, ATMA/TYPE34, A6/TYPE38, SINK/TYPE40, DOA/TYPE259, NXNAME/TYPE128,
;    TYPE65280)
; 6. メタレコード / QTYPE (OPT, TSIG, TKEY, ANY, AXFR, IXFR, MAILB, MAILA)
;    についてはゾーンデータとしては存在し得ない仕様上の理由をコメントで解説しています。
; ============================================================================

$TTL 86400
$ORIGIN example.com.

; ----------------------------------------------------------------------------
; SOA / NS (ゾーンとして最低限必須)
; ----------------------------------------------------------------------------
@       IN SOA  ns1.example.com. hostmaster.example.com. (
                        2026071001 ; serial (YYYYMMDDnn)
                        3600       ; refresh (1 hour)
                        900        ; retry (15 minutes)
                        1209600    ; expire (2 weeks)
                        86400 )    ; minimum / negative cache TTL

        IN NS   ns1.example.com.
        IN NS   ns2.example.com.

; DNSKEY は dnssec-keygen が生成した鍵ファイルを $INCLUDE するのが定石
$INCLUDE example.com.dnskey

; 追加ホストレコードを別ファイルに分離して $INCLUDE する例
$INCLUDE example.com.hosts

; ----------------------------------------------------------------------------
; A / AAAA
; ----------------------------------------------------------------------------
ns1     IN A     192.0.2.1
ns2     IN A     192.0.2.2
ns1     IN AAAA  2001:db8::1
ns2     IN AAAA  2001:db8::2

www     IN A     192.0.2.10
www     IN AAAA  2001:db8::10

mail    IN A     192.0.2.20
mail2   IN A     192.0.2.21

*.wild  IN A     192.0.2.90

; ----------------------------------------------------------------------------
; CNAME / DNAME
; ----------------------------------------------------------------------------
ftp     IN CNAME www.example.com.
legacy  IN DNAME archive.example.com. ; legacy配下すべてをarchive配下へ委譲

; ----------------------------------------------------------------------------
; MX / TXT / SPF / AVC
; ----------------------------------------------------------------------------
@       IN MX 10 mail.example.com.
@       IN MX 20 mail2.example.com.

@       IN TXT "v=spf1 mx a:mail.example.com -all"

; SPF (RFC 4408) レコードタイプは RFC 7208 で Historic 化されており、
; 現在はTXTレコードでSPFを表現するのが標準です。参考として残しますが
@       IN SPF "v=spf1 mx a:mail.example.com -all"

; AVC (Application Visibility and Control, Type 258)
app-vis IN AVC "app=web" "env=production"

; ----------------------------------------------------------------------------
; SRV / NAPTR / URI
; ----------------------------------------------------------------------------
_sip._tcp       IN SRV 10 60 5060 sipserver.example.com.
sipserver       IN A 192.0.2.30

_ldap._tcp      IN NAPTR 100 10 "S" "LDAP2+D2U" "" _ldap._tcp.example.com.

_https._tcp     IN URI 10 1 "https://www.example.com/"

; ----------------------------------------------------------------------------
; HTTPS / SVCB (RFC 9460)
; ----------------------------------------------------------------------------
@       IN HTTPS 1 . alpn=h2,h3
www     IN HTTPS 1 . alpn=h2

svc             IN A 192.0.2.40
_8443._tcp.svc  IN SVCB 1 svc.example.com. alpn=h2 port=8443

dns             IN A 192.0.2.53
                IN AAAA 2001:db8::53
_dns.resolver   IN SVCB 1 dns.example.com. alpn="dot"
_dns.resolver   IN SVCB 2 dns.example.com. alpn="h2,h3" key7="/dns-query{?dns}"

; ----------------------------------------------------------------------------
; TLSA (DANE)
; ----------------------------------------------------------------------------
_443._tcp.www   IN TLSA 3 1 1 (
    d2abde240d7cd3ee6b4b28c54df034b97983a1d16e8a410e4561cb106618e971 )

; ----------------------------------------------------------------------------
; SSHFP
; ----------------------------------------------------------------------------
ns1     IN SSHFP 1 1 a5e9e44c8142a57e4c70d04b2dbb652ef7cd3558
ns1     IN SSHFP 4 2 (
    513b28eb456f25db89fe68973f5946afba1499c07d011d5a3466bb33c76f8192 )

; ----------------------------------------------------------------------------
; CAA
; ----------------------------------------------------------------------------
@       IN CAA 0 issue "letsencrypt.org"
@       IN CAA 0 issuewild ";"
@       IN CAA 0 iodef "mailto:security@example.com"

; ----------------------------------------------------------------------------
; LOC / GPOS
; ----------------------------------------------------------------------------
@       IN LOC 35 10 0.000 N 136 58 0.000 E 10.00m 100m 10m 10m
office  IN LOC 37 26 0.000 N 122 8 0.000 W 100.00m 1m 10000m 10m
hq      IN LOC 35 N 139 E 0m

; 経度(longitude), 緯度(latitude), 高度(altitude: メートル)
site.example.com.    3600  IN  GPOS  "-32.6866" "-70.1509" "12.0"

; ----------------------------------------------------------------------------
; HINFO / RP / MINFO
; ----------------------------------------------------------------------------
ns1         IN HINFO "Generic-PC" "Linux"
@           IN RP hostmaster.example.com. admin-info.example.com.
admin-info  IN TXT "Contact the network operations team"

; MINFO (Mailbox / Mail list information, RFC 1035, Type 14)
minfo-list  IN MINFO hostmaster.example.com. list-errors.example.com.
list-errors IN TXT "Report mailing list delivery errors to this mailbox"

; ----------------------------------------------------------------------------
; AFSDB / RT / KX / PX / HIP
; ----------------------------------------------------------------------------
@       IN AFSDB 1 afsdb.example.com.
afsdb   IN A 192.0.2.50

; RT (Route Through, RFC 1183, Type 21)
backup-router IN RT 10 router.example.com.
router        IN A  192.0.2.25

; KX (Key Exchanger, RFC 2230, Type 36)
kdc     IN KX 10 kdc1.example.com.
kdc1    IN A  192.0.2.26

; PX (X.400 Mail Information, RFC 2163, Type 26)
x400-gw IN PX 10 prmd-a.example.com. admd-b.example.com.

host-hip IN HIP ( 2 1B16A611E21577146EB10AC91B5EE027
    z+dS47XItL/GDrIZ736/ChYfkg3EvMkSaD2D0Rbot3lBwte5Ek2Rq3Q2Cxa3FEUU
    m8Cr6cDPCLrW49OEu6ObcQ== )

; ----------------------------------------------------------------------------
; WKS (Well-Known Services, RFC 1035, Type 11)
; ----------------------------------------------------------------------------
mail    IN WKS 192.0.2.20 TCP 25 80 110
ns1     IN WKS 192.0.2.1 UDP 53

; ----------------------------------------------------------------------------
; ISDN / X25
; ----------------------------------------------------------------------------
; サブアドレスなし
relay.example.com.   3600  IN  ISDN  "150862028003217"
; サブアドレス（004）あり
pbx.example.com.     3600  IN  ISDN  "150862028003217" "004"
route1.example.com.  3600  IN  X25   "311061700956"

; ----------------------------------------------------------------------------
; NSAP / NSAP-PTR (RFC 1706, Types 22, 23)
; ----------------------------------------------------------------------------
osi.example.com.     3600  IN  NSAP  0x47.0005.80.005a00.0000.0001.e133.ffffff000161.00
nsap-ptr-node        3600  IN  NSAP-PTR osi.example.com.

; ----------------------------------------------------------------------------
; ILNP (Identifier-Locator Network Protocol, RFC 6742: NID, L32, L64, LP)
; ----------------------------------------------------------------------------
ilnp-node   IN NID 10 0014:4f01:0000:0001
ilnp-node   IN L32 10 192.0.2.1
ilnp-node   IN L64 10 2001:0db8:0000:0001
ilnp-node   IN LP  10 lpserver.example.com.
lpserver    IN A   192.0.2.35

; ----------------------------------------------------------------------------
; AMTRELAY (Automatic Multicast Tunneling Relay, RFC 8777, Type 260)
; ----------------------------------------------------------------------------
amt-v4      IN AMTRELAY 10 0 1 192.0.2.1
amt-v6      IN AMTRELAY 10 0 2 2001:db8::1
amt-gw      IN AMTRELAY 10 0 3 gw.example.com.

; ----------------------------------------------------------------------------
; DHCID
; ----------------------------------------------------------------------------
dhcphost IN DHCID ( M0LKbNXwrVdvwnLP+cLy5CAjRbsyRzwyr9DMcRBf54rnXWWJ )

; ----------------------------------------------------------------------------
; IPSECKEY
; ----------------------------------------------------------------------------
gw      IN IPSECKEY ( 10 1 2 192.0.2.60
    xXSx9Rxs5YKfvmrBRmae9qKRmUjoRW3d6QIt9rGU3a62fFz7D+nteciVRA77l9Cb
    /Lqwm8+Lt/n8xtDeSqwDBw== )

; ----------------------------------------------------------------------------
; CERT / SMIMEA / OPENPGPKEY
; ----------------------------------------------------------------------------
host-cert IN CERT PGP 0 0 (
    wLH49o6Tb9GlU9DIN4YcfFY+60kmG8DjaGPoNNopKhnA1Jx1dJgUqg== )

; 実運用ではオーナー名にローカルパートのSHA-256ハッシュを使いますが、
; ここでは分かりやすさのため簡略化した名前にしています。
smimea-example  IN SMIMEA 3 1 1 (
    9c95c410df69856955cc3e9c3574942985d0885c81740de118d0b4c901ac314e )

openpgp-example IN OPENPGPKEY (
    rDF/X4VG2slaNuarQ4drfCxQQHNYngYLFBR6FEHl3wDs9py6E1/aExsS5KXh5g== )

; ----------------------------------------------------------------------------
; APL
; ----------------------------------------------------------------------------
@       IN APL 1:192.0.2.0/24 !1:192.0.2.128/25 2:2001:db8::/32
network IN APL 1:192.168.0.0/24 !1:192.168.1.0/24 2:2001:db8::/32

; ----------------------------------------------------------------------------
; EUI48 / EUI64
; ----------------------------------------------------------------------------
printer1 IN EUI48 00-1A-2B-3C-4D-5E
sensor1  IN EUI64 00-1A-2B-3C-4D-5E-6F-70

; ----------------------------------------------------------------------------
; PTR
; PTRは通常 in-addr.arpa / ip6.arpa の逆引きゾーンで使用されますが、
; 正引きゾーン内でも構文上記述可能です。
; ----------------------------------------------------------------------------
10.2.0.192.in-addr.arpa. IN PTR www.example.com.
ptr-host                 IN PTR www.example.com.

; ----------------------------------------------------------------------------
; 委任先ゾーンの例(親ゾーン側に置くDSレコード)
; ※ named-checkzone は委任先のグルーレコードについて
;   "(out of zone) has no addresses records" という情報メッセージを
;   表示することがありますが、これは委任の仕組み上の正常な挙動であり
;   ロードエラーではありません。
; ----------------------------------------------------------------------------
secure          IN NS ns1.secure.example.com.
secure          IN NS ns2.secure.example.com.
ns1.secure      IN A 192.0.2.70
ns2.secure      IN A 192.0.2.71
secure          IN DS 12345 8 2 (
    E7B1692856465B7B66A9F25B54C3A9C84078C024F719F3FB370F8595B17DA08F )

; ----------------------------------------------------------------------------
; CSYNC / DSYNC (RFC 7477 / RFC 9859)
; ----------------------------------------------------------------------------
@                   IN CSYNC 2026071001 3 A AAAA NS
_dsync.example.com. IN DSYNC A NOTIFY 53 ns1.example.com.

; ----------------------------------------------------------------------------
; DNSSEC関連レコード (RRSIG, NSEC, NSEC3, NSEC3PARAM, ZONEMD, CDS, CDNSKEY, KEY, TA, DLV)
; ----------------------------------------------------------------------------
; RRSIG: 各RRsetに対する署名
example.com. 86400 IN RRSIG A 13 4 86400 20300101000000 20260101000000 12345 example.test.ldns.jp. (
    AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
    AAAAAAAAAAAAAAAAAAAAAA== )

; NSEC: 存在しないことの証明用レコード
www.example.com. IN NSEC mail.example.com. A AAAA RRSIG NSEC

; NSEC3 / NSEC3PARAM: NSECのハッシュ化版
9D5RUJH8EGBAK2P0S9V03QAA9J8VQNQ6.example.com. IN NSEC3 1 0 10 AABBCCDD (
    9D6RUJH8EGBAK2P0S9V03QAA9J8VQNQ7 A AAAA RRSIG )
@ IN NSEC3PARAM 1 0 10 AABBCCDD

; ZONEMD: ゾーン全体の内容から計算するダイジェスト
@       IN ZONEMD 2026071001 1 1 4ba7dc5aab05911764e3a23f4b04ec850bba5d4da9391c2cfa2eca47ad1c1407628c2893906cfe702b9a73d3f3082aa9

; CDS / CDNSKEY: 子ゾーンが親ゾーンにDS/DNSKEY更新を通知
@       IN CDS     23534 13 2 fcdb742c06b9a17cd02ccd070f9b8f4a9376e1f1a34b960bfab565fbea4e01d8
@       IN CDNSKEY 257 3 13 (
    Gt5VRfB9PU4fsMAgkp+4Lux7ikef1M2e/ZtbggoiyDxZ
    hKunv9246kZG2JSyg3VHgWpLeQLV+eIQ8NlePcXJUg== )

; KEY (RFC 2535, Type 25): 古典的DNSSEC鍵レコード
host-key IN KEY 256 3 13 (
    Gt5VRfB9PU4fsMAgkp+4Lux7ikef1M2e/ZtbggoiyDxZ
    hKunv9246kZG2JSyg3VHgWpLeQLV+eIQ8NlePcXJUg== )

; TA (Trust Anchor, RFC 4431, Type 32768)
ta-root IN TA 12345 8 2 (
    E7B1692856465B7B66A9F25B54C3A9C84078C024F719F3FB370F8595B17DA08F )

; DLV (DNSSEC Lookaside Validation, RFC 4431 / RFC 8749 Historic, Type 32769)
dlv-example IN DLV 12345 8 2 (
    E7B1692856465B7B66A9F25B54C3A9C84078C024F719F3FB370F8595B17DA08F )

; ----------------------------------------------------------------------------
; Early Mailbox Records (RFC 883 / RFC 973 / RFC 1035: MD, MF, MB, MG, MR)
; ※ 歴史的なメールボックス関連レコード。現在は MX / TXT に移行していますが
;   KariDNSパーサーおよびワイヤー処理で完全に対応しています。
; ----------------------------------------------------------------------------
user-md     IN MD hostmaster.example.com.
user-mf     IN MF hostmaster.example.com.
user-mb     IN MB mail.example.com.
group-mg    IN MG user-mb.example.com.
user-mr     IN MR mail2.example.com.

; ----------------------------------------------------------------------------
; Experimental / Historic / Draft / RFC 3597 Generic Records
; ----------------------------------------------------------------------------
; NULL (RFC 883/1035, Type 10)
null-node   IN NULL \# 4 01020304

; NXT (RFC 2535, Type 30) - valid text format: Next Domain Name + type list
nxt-node    IN NXT atma-node.example.failed. A

; EID (Endpoint Identifier, Type 31)
eid-node    IN EID \# 4 01020304

; NIMLOC (Nimrod Locator, Type 32)
nimloc-node IN NIMLOC \# 4 01020304

; ATMA (ATM Address, Type 34, RFC 2163)
; format=0 (E.164) + ASCII digits
atma-node   IN ATMA 0 16175551234

; A6 (IPv6 with prefix chain, Type 38, RFC 2874)
; prefix-length=0 → full IPv6 address, no prefix name required
a6-node     IN A6 0 2001:db8::1

; SINK (Type 40)
sink-node   IN SINK \# 4 01020304

; DOA (Digital Object Architecture, Type 259, RFC 7169)
; enterprise=0 type=0 location=0 media-type="" data=base64("hello")
doa-node    IN DOA 0 0 0 "" aGVsbG8=

; SIG (RFC 2535, Type 24) — 旧式DNSSEC署名、RRSIG と同一ワイヤ形式
; 実際の署名データはRRSIGと同フォーマット (タイプカバード + アルゴリズム + ...)
sig-node    IN SIG A 13 4 86400 20300101000000 20260101000000 12345 example.com. (
    AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
    AAAAAAAAAAAAAAAAAAAAAA== )

; NINFO (Experimental, Type 56) — TXT と同一ワイヤ形式
ninfo-node  IN NINFO "status=operational" "location=datacenter-1"

; RKEY (Experimental, Type 57, draft-reid-dnsext-rkey-00) — flags MUST be 0, protocol MUST be 1
rkey-node   IN RKEY 0 1 13 (
    Gt5VRfB9PU4fsMAgkp+4Lux7ikef1M2e/ZtbggoiyDxZ
    hKunv9246kZG2JSyg3VHgWpLeQLV+eIQ8NlePcXJUg== )

; TALINK (Trust Anchor LINK, Type 58)
; format: previous-ta-name next-ta-name (両方ドメイン名)
talink-node IN TALINK . ta-root.example.com.

; HHIT (Host Identity Tag, RFC 9886, Type 67) — opaque base64
hhit-node   IN HHIT ( AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA )

; BRID (Bound RVS Identifier, RFC 9886, Type 68) — opaque base64
brid-node   IN BRID ( AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA )

; RFC 3597 Generic Unknown Record (TYPE65280)
generic-rr  IN TYPE65280 \# 4 c0000201

; ----------------------------------------------------------------------------
; ゾーンファイルのデータとしてはそもそも存在し得ないメタレコード / QTYPE
; ----------------------------------------------------------------------------
; OPT (Type 41, RFC 6891): EDNS0擬似レコード。DNSメッセージのAdditionalセクションに
;       動的に付与されるプロトコル拡張用であり、ゾーンファイルには保存されない。
; TSIG (Type 250, RFC 8945): メッセージ認証・トランザクション署名用メタレコード。
;       DNSメッセージのAdditionalセクションに付与される。
; TKEY (Type 249, RFC 2930): 共有鍵の帯域外合意/転送に使われる一時的なメタレコード。
; ANY (Type 255, RFC 1035): レコードタイプではなく問い合わせ専用のQTYPE。
; AXFR (Type 252, RFC 5936): ゾーン転送要求専用のQTYPE。
; IXFR (Type 251, RFC 1995): 差分ゾーン転送要求専用のQTYPE。
; MAILB (Type 253, RFC 1035): メールボックス関連全レコード問い合わせ用QTYPE。
; MAILA (Type 254, RFC 1035): メールエージェント問い合わせ用QTYPE。
; NXNAME (Type 128, RFC 9824): コンパクト否定応答(Compact Denial of Existence)用のメタレコード。
; ----------------------------------------------------------------------------
; $GENERATE の使用例
; ----------------------------------------------------------------------------

; host1.example.com. 〜 host50.example.com. を
; 192.0.2.101 〜 192.0.2.150 に一括で割り当てる例
$GENERATE 1-50 host$ IN A 192.0.2.${100}

; wifi-0.example.com. 〜 wifi-9.example.com. を
; 192.0.3.0 〜 192.0.3.9 に割り当てる例
$GENERATE 0-9 wifi-$ IN A 192.0.3.$

; 参考: 逆引きゾーン(2.0.192.in-addr.arpa.)で使う場合の典型例
; (このファイル=正引きゾーンには含めていません)
;$GENERATE 1-254 $ IN PTR host$.example.com.

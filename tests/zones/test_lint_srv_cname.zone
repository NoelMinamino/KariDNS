; X-39: SRV targets that point to a CNAME (RFC 2782 "Target": MUST NOT be an alias)
$ORIGIN srv.test.
$TTL 300
@          IN SOA ns1 hostmaster 1 7200 3600 1209600 300
@          IN NS  ns1
ns1        IN A   192.0.2.1
_sip._tcp  IN SRV 10 5 5060 alias
_ldap._tcp IN SRV 10 5 389 host
_none._tcp IN SRV 0 0 0 .
alias      IN CNAME host
host       IN A   192.0.2.10

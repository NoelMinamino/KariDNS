#!/bin/sh
#
# PROVIDE: karidns
# REQUIRE: DAEMON NETWORKING
# KEYWORD: shutdown
#
# Add the following lines to /etc/rc.conf to enable karidns:
#
# karidns_enable="YES"
# karidns_flags=""
# karidns_config="/usr/local/etc/karidns/karidns.conf"
# karidns_log_dir="/var/log/named"   the log directory that is created at start when it is missing (an existing one is never changed)
# karidns_log_owner=""               its owner then, "user" or "user:group" (default: options { user; group; } of the configuration)
#

. /etc/rc.subr

name="karidns"
rcvar="karidns_enable"

command="/usr/local/sbin/karidns"
pidfile="/var/run/karidns/karidns.pid"

load_rc_config "${name}"

: ${karidns_enable:="NO"}
: ${karidns_config:="/usr/local/etc/karidns/karidns.conf"}
: ${karidns_flags:="${karidns_config}"}
: ${karidns_log_dir:="/var/log/named"}
: ${karidns_log_owner:=""}

required_files="${karidns_config}"
extra_commands="reload checkconf"
reload_cmd="karidns_reload"
checkconf_cmd="karidns_checkconf"
start_precmd="karidns_prestart"

# karidns_conf_identity FILE: "user:group" of options { user "..."; group "..."; } as karidns reads them (either may be empty), or a failure
# when this cannot tell.  The tokens are those of the server's lexer (dns_config_parser.c): # and // comments to the end of the line, /* */
# comments, "quoted strings" without escapes, { } ; and words that end at a space, { } ; # // or /*  (so `user"karidns";` is the one word
# user"karidns", which karidns refuses, not a user).  The last user / group of options wins, as in the server.  `include "file";` is
# followed one level deep (relative to options { directory } when it came before, else to the directory of FILE); an include inside an
# included file, a relative directory, a file that cannot be read, an unclosed comment or string and unbalanced braces are a failure.
karidns_conf_identity()
{
    awk -v main="$1" '
    function lex(f, A,    s, l, r, n, i, j, c, len, w) {
        s = ""
        while ((r = (getline l < f)) > 0) s = s l "\n"
        close(f)
        if (r < 0) return -1
        n = 0; i = 1; len = length(s)
        while (i <= len) {
            c = substr(s, i, 1)
            if (c == " " || c == "\t" || c == "\n" || c == "\r") { i++; continue }
            if (c == "#" || substr(s, i, 2) == "//") { j = index(substr(s, i), "\n"); i = j ? i + j : len + 1; continue }
            if (substr(s, i, 2) == "/*") { j = index(substr(s, i + 2), "*/"); if (!j) return -1; i += j + 3; continue }
            if (c == "{" || c == "}" || c == ";") { A[++n] = c; i++; continue }
            if (c == "\"") { j = index(substr(s, i + 1), "\""); if (!j) return -1; A[++n] = "Q" substr(s, i + 1, j - 1); i += j + 1; continue }
            w = ""
            while (i <= len) {
                c = substr(s, i, 1)
                if (c == " " || c == "\t" || c == "\n" || c == "\r" || c == "{" || c == "}" || c == ";" || c == "#") break
                if (c == "/" && (substr(s, i + 1, 1) == "/" || substr(s, i + 1, 1) == "*")) break
                w = w c; i++
            }
            A[++n] = "W" w
        }
        return n
    }
    # walk the tokens A[1..n] of a file at include level lvl; depth, cnt[], first[], val, inopt, user, group, dir: the parse so far
    function walk(A, n, lvl, base,    k, t, p, B, m) {
        for (k = 1; k <= n; k++) {
            t = A[k]
            if (t == "Winclude") {
                if (lvl > 0 || k + 2 > n || A[k + 1] !~ /^[QW]/ || A[k + 2] != ";") return 0
                p = substr(A[k + 1], 2); k += 2
                if (p !~ /^\//) { if (dir != "" && dir !~ /^\//) return 0; p = (dir != "" ? dir : base) "/" p }
                split("", B)
                if ((m = lex(p, B)) < 0) return 0
                if (!walk(B, m, lvl + 1, base)) return 0
                continue
            }
            if (t == "{") {
                if (depth == 0) inopt = (cnt[0] == 1 && first[0] == "options")
                cnt[depth]++; depth++; cnt[depth] = 0
                continue
            }
            if (t == "}") { if (--depth < 0) return 0; continue }
            if (t == ";") {
                if (depth == 1 && inopt && cnt[1] == 2) {
                    if (first[1] == "user") user = val
                    else if (first[1] == "group") group = val
                    else if (first[1] == "directory") dir = val
                }
                cnt[depth] = 0
                if (depth == 0) inopt = 0
                continue
            }
            if (++cnt[depth] == 1) first[depth] = substr(t, 2)
            else if (cnt[depth] == 2) val = substr(t, 2)
        }
        return 1
    }
    BEGIN {
        base = main; if (base !~ /\//) base = "."; else { sub(/\/[^\/]*$/, "", base); if (base == "") base = "/" }
        depth = 0; cnt[0] = 0
        if ((n = lex(main, T)) < 0 || !walk(T, n, 0, base) || depth != 0) exit 1
        print user ":" group
    }'
}

# karidns_log_dir_make: the log directory, when it is missing, for the user the server runs as (docs/distribution.md "The user karidns").  An
# existing directory is left as it is (its owner and mode are the operator's: an installation of an earlier version keeps the directory of
# its user).  The owner: karidns_log_owner ("user" or "user:group"), else options { user } of the configuration with options { group } or
# else that user's primary group; when neither tells, the start is refused (there is no guess: FreeBSD always has the user bind).
karidns_log_dir_make()
{
    [ -d "${karidns_log_dir}" ] && return 0
    if [ -n "${karidns_log_owner}" ]; then
        _user=${karidns_log_owner%%:*}
        _group=""
        case "${karidns_log_owner}" in *:*) _group=${karidns_log_owner#*:} ;; esac
        _from="karidns_log_owner"
    elif _id=$(karidns_conf_identity "${karidns_config}") && [ -n "${_id%%:*}" ]; then
        _user=${_id%%:*}
        _group=${_id#*:}
        _from="options { user } of ${karidns_config}"
    else
        echo "${name}: ${karidns_log_dir} is missing, and the user karidns runs as cannot be told from ${karidns_config}" \
            "(no options { user }, or an include in an included file): set karidns_log_owner=\"user[:group]\" in rc.conf or create the directory" >&2
        return 1
    fi
    if [ -z "${_user}" ] || ! id -u "${_user}" >/dev/null 2>&1; then
        echo "${name}: the user '${_user}' of ${_from} does not exist: ${karidns_log_dir} is not created" >&2
        return 1
    fi
    if [ -z "${_group}" ]; then
        _group=$(id -gn "${_user}") || return 1
    fi
    install -d -o "${_user}" -g "${_group}" -m 0755 "${karidns_log_dir}"
}

karidns_prestart()
{
    # Validate config with karicheck before starting
    if [ -x /usr/local/bin/karicheck ]; then
        /usr/local/bin/karicheck conf "${karidns_config}" || return 1
    fi
    # /var/run/karidns must be root:wheel (0755) to satisfy ensure_priv_dir_safe()
    install -d -o root -g wheel -m 0755 /var/run/karidns
    karidns_log_dir_make
}

karidns_reload()
{
    if [ -x /usr/local/bin/karictl ]; then
        echo "Reloading ${name} via karictl..."
        /usr/local/bin/karictl reload
    else
        echo "Reloading ${name} via SIGHUP..."
        kill -HUP $(cat "${pidfile}" 2>/dev/null)
    fi
}

karidns_checkconf()
{
    if [ -x /usr/local/bin/karicheck ]; then
        echo "Checking configuration: ${karidns_config}"
        /usr/local/bin/karicheck conf "${karidns_config}"
    else
        echo "karicheck not found."
    fi
}

run_rc_command "$1"

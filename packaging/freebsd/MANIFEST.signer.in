name: "karidns-signer"
version: "__VERSION__"
origin: "dns/karidns-signer"
comment: "Signer daemon for KariDNS database zones (static DNSSEC)"
arch: "__ARCH__"
www: "https://github.com/NoelMinamino/KariDNS"
maintainer: "NoelMinamino@users.noreply.github.com"
prefix: "/usr/local"
licenselogic: "single"
licenses: [
    "MIT"
]
desc: <<EOD
karidns-signer keeps the zones of a KariDNS database (PostgreSQL or SQLite3) signed: it runs BIND's dnssec-keygen and
dnssec-signzone and karidns-zone (from karidns-sqlite3, karidns-postgresql or karidns-db, which must be installed first).
Upgrading from 0.6.x with pkg add: add the 0.7 database package first (a 0.6.x one provides no karidns-zone, and pkg add
refuses this package with "Missing provide karidns-zone"); pkg upgrade from a repository upgrades both together.
EOD
categories: [
    "dns",
    "net",
    "sysutils"
]
requires: [ "karidns-zone" ]
scripts: {
    pre-install: <<EOD
if [ ! -x /usr/local/bin/karidns-zone ]; then
    echo "karidns-signer needs karidns-zone: install karidns-sqlite3, karidns-postgresql or karidns-db first" >&2
    exit 1
fi
pw groupshow karidns-signer >/dev/null 2>&1 || pw groupadd karidns-signer
pw usershow karidns-signer >/dev/null 2>&1 || pw useradd karidns-signer -g karidns-signer -h - -d /var/db/karidns-signer -s /usr/sbin/nologin -c "KariDNS signer"
EOD
}
deps: {
__DEPS__
}
files: {
__FILES__
}

options {
    port 53;
    
    // リッスンするIPアドレス (IPv4 / IPv6)
    bind-address { 0.0.0.0; ::; };
    
    // 起動後にドロップする特権ユーザーとグループ
    user "named";
    group "named";

    // PIDファイル ("none" で作成を無効化、未指定時は /var/run/karidns/karidns.pid)
    // pid-file "/var/run/karidns/karidns.pid";

    // UDPソケットバッファサイズ (未指定時のデフォルト: 4M)
    // OSの上限値(kern.ipc.maxsockbuf sysctl)を超えると切り詰められます
    udp-recvbuf-size 4M;
    udp-sndbuf-size 4M;

    // TCP / UDP の転送パラメータ (未指定時は OS 既定値、UDP ペイロード上限は 1232)
    // tcp-window は listen ソケットに設定するため、変更の反映には再起動が必要です
    // tcp-mss は接続確立後に送信 MSS を下げる方向にのみ効きます
    // ゾーン単位の上書き (zone-tcp-mss / zone-tcp-window / zone-tcp-sndbuf /
    // zone-udp-bufsize) と制約は docs/karidns.md の TRANSPORT TUNING を参照
    // tcp-mss 1220;
    // tcp-window 256K;
    // udp-bufsize 1232;

    // Response Rate Limiting (RRL) - DNSリフレクション攻撃対策
    // 指定しない場合はRRLは無効（制限なし）となります
    rate-limit {
        responses-per-second 50;
        nodata-per-second 50;
        nxdomains-per-second 20;
        errors-per-second 10;
        window 15;
        slip 2;
        // log-only yes; // 有効にすると制限はせずログ出力のみ行います
        exempt-clients { 127.0.0.1/32; 192.168.0.0/16; ::1/128; };
    };
};

logging {
    channel queries_log {
        // 容量ベースのローテーション (10MBを超えたらローテーション、3世代保存)
        file "/var/log/named/queries.log" versions 3 size 10M;
        
        // 日付ベース(日次)ローテーションの場合は以下を使用:
        // file "/var/log/named/queries.log" versions 3 suffix timestamp;
        
        print-time yes;
        print-category yes;
        print-severity yes;
    };
    category queries { queries_log; };
};

// karictl コントロールチャネルの設定
// karictlコマンドによる動的リロードやステータス確認を許可する場合に設定します
control-channel {
    // コントロール用UNIXドメインソケットパス (未指定時は /var/run/karidns/control.sock)
    // socket "/var/run/karidns/control.sock";
    algorithm "hmac-sha256";
    // karictl.conf側の key "karictl" に設定した secret と一致させてください
    // 下の値はプレースホルダです (このままだと起動時に警告が出ます)。
    // 必ず `openssl rand -base64 32` の出力に置き換えてください
    secret "UkVQTEFDRS1NRTpvcGVuc3NsLXJhbmQtYmFzZTY0LTMy";
};

// 外部設定ファイルのインクルード (include ディレクティブ)
// トップレベルだけでなく、ブロック内やリストの途中など任意の場所で使用できます。
// 相対パスは当設定ファイルの配置ディレクトリを起点に解決されます。
// include "/usr/local/etc/karidns/keys.conf";

// ゾーン転送(AXFR)やNOTIFYで使用するTSIGキー
key "tsig-key-example" {
    algorithm "hmac-sha256";
    // プレースホルダです。`openssl rand -base64 32` の出力に置き換えてください
    secret "UkVQTEFDRS1NRTpvcGVuc3NsLXJhbmQtYmFzZTY0LTMy";
};

// マスターゾーンの定義
zone "example.local" {
    type master;
    file "/usr/local/etc/karidns/zones/example.local.zone";
    allow-transfer { 127.0.0.1; };
};

zone "example.com" {
    type master;
    file "/usr/local/etc/namedb/master/example.com.zone";
    allow-transfer {
        192.168.1.100;
        // include "acls/common_slaves.conf"; // リスト途中での外部ファイル展開も可能
    };
    also-notify { 192.168.1.100 port 53; };
    notify-source "192.168.1.1";
    // ゾーン単位の転送パラメータ (クエリ受信後に接続へ適用。MSS は下げる方向のみ)
    // zone-tcp-sndbuf 2M;       // AXFR など大きな応答の送信バッファ
    // zone-tcp-window 128K;
    // zone-tcp-mss 1200;
    // zone-udp-bufsize 1232;
    
    // 特定のゾーンに対してRRL設定を上書きすることも可能
    // 指定した場合はグローバルオプションより優先されます
    rate-limit {
        responses-per-second 100;
        slip 0; // slipを0にするとTC応答せず即座に破棄します
    };
};

// スレーブゾーンの定義
zone "slave.example.net" {
    type slave;
    file "/usr/local/etc/namedb/slave/slave.example.net.zone";
    masters { 10.0.0.1 port 53; };
    tsig-key "tsig-key-example";
    // マスターからの転送を受ける TCP 接続にも適用されます (受信バッファは connect 前に設定)
    // zone-tcp-window 1M;
};

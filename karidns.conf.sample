options {
    // 待受ポート。1024未満 (53など) はroot起動が必要。一般ユーザーで起動する
    // 場合は 10053 などを指定する (bindできないポートでは起動エラーになる)
    port 53;
    
    // リッスンするIPアドレス (IPv4 / IPv6)
    bind-address { 0.0.0.0; ::; };

    // BIND 9 の書き方もそのまま使える。bind-address と併用すると両方のアドレスの和集合になる
    // (同じアドレスにポートが2つあるとエラー)。リストは起動時のインターフェースのアドレスと
    // 照合する。`any` だけのリストはワイルドカード (0.0.0.0 / ::) を開く。
    // どちらも書かない側のアドレスファミリ (listen-on だけ書いて listen-on-v6 を書かない等) は
    // ワイルドカードで待ち受ける。IPv6 を使わないなら listen-on-v6 { none; }; と書く。
    // 変更の反映には再起動が必要 (reload すると "restart needed" と表示される)。
    // listen-on { 127.0.0.1; };
    // listen-on port 5353 { 192.0.2.1; };
    // listen-on-v6 { none; };

    // blackhole: リストに一致する送信元からのリクエストは、応答せずに捨てる (UDP も TCP も)。
    // 先頭に一致した要素で決まる ("!192.0.2.1;" だけでは何も捨てない。それ以外を捨てるなら
    // "!192.0.2.1; any;")。reload で反映できる
    // blackhole { 198.51.100.0/24; };
    
    // 起動後にドロップする特権ユーザーとグループ
    // root起動時は必須。一般ユーザーで直接起動する場合は省略するか、
    // 起動ユーザー自身を指定する (他ユーザーを指定すると起動エラー)
    // (FreeBSD の BIND 用の標準のユーザーとグループは "bind"。ここは実際に存在するものに合わせる)
    user "named";
    group "named";

    // 作業ディレクトリ (BIND の directory)。設定すると、相対パスの zone の file、
    // pid-file、ログの file、include、ゾーンファイルの $INCLUDE はすべてここからの
    // 相対になる (絶対パスの指定を推奨)。未指定なら起動したディレクトリからの相対
    // (ただし include は、directory が無ければ設定ファイルの置き場所からの相対: 下の include の説明を参照)。
    // 起動時に開くので、変更の反映には再起動が必要。$INCLUDE で読めるのは
    // ゾーンファイルのディレクトリ以下と directory 以下だけ (Capsicum の制約)
    // directory "/usr/local/etc/karidns";

    // PIDファイル ("none" で作成を無効化、未指定時は /var/run/karidns/karidns.pid)
    // 一般ユーザーで起動する場合は書き込み可能なディレクトリを指定する
    // pid-file "/var/run/karidns/karidns.pid";

    // アクセス制御 (BIND の address match list。先頭から最初に一致した要素で決まる。
    // 詳細は docs/karidns.md の "Address match lists")。view / zone の同名の文が優先される
    // allow-query { localhost; localnets; };   // 問い合わせを受け付けるクライアント (未指定は全員)
    // allow-transfer { 192.0.2.10; };          // ゾーン転送 (AXFR/IXFR) を許可するクライアント (未指定は拒否)

    // 転送と NOTIFY (BIND 9.20 と同じ名前・既定値。zone > view > options の順。詳細は docs/karidns.md の
    // "Transfer and NOTIFY options"。送信元アドレスは起動時に bind できなければ起動しない。リロードで増やした
    // アドレスは再起動後に有効)
    // transfer-source 192.0.2.1;  notify-source 192.0.2.1;   // 転送 (TCP) と NOTIFY の送信元 (* = OS に任せる)
    // min-refresh-time 300; max-refresh-time 2419200;        // SOA の REFRESH を挟む範囲 (秒)
    // min-retry-time 500;   max-retry-time 1209600;          // SOA の RETRY を挟む範囲 (秒)
    // max-transfer-time-in 120; max-transfer-idle-in 60;     // 入ってくる転送の上限 (分)
    // transfers-in 10; transfers-out 10; transfers-per-ns 2; // 同時に行う転送の数
    // notify-retries 2; notify-retry-interval 5;             // NOTIFY の UDP 再送の回数と間隔 (秒)。既定は BIND 9.20 と同じ
    // notify-retry-backoff fixed; notify-tcp-timeout 15;     // 再送間隔の増やし方、TCP での 1 回の試みの秒数 (zone でも指定できる)

    // BIND の値の書き方 (docs/karidns.md の "BIND option values")
    // TCP のタイムアウトの単位は BIND と同じ 100 ms。ミリ秒で書くときは ms を付ける (10000 のような
    // 1200 を超える数字だけの値は、昔のミリ秒の値かもしれないのでエラーになる)
    // tcp-idle-timeout 100;       // 10 秒
    // tcp-initial-timeout 10000ms;
    // version.bind / hostname.bind / id.server (CH の TXT)。何も書かないと version は KariDNS の版、hostname は
    // ホスト名で答える。答えたくなければ none。server-id は NSID にもなる
    // version none;  hostname none;  server-id "ns1";
    // minimal-responses no-auth;   // yes | no | no-auth | no-auth-recursive
    // require-server-cookie yes;   // サーバー Cookie の無い UDP クエリに BADCOOKIE を返す (RFC 7873)
    // max-udp-size 1232;           // udp-bufsize の別名。udp-receive-buffer / udp-send-buffer / tcp-receive-buffer / tcp-send-buffer も使える
    // max-records 1000000;  max-records-per-type 100;  max-types-per-name 100;  max-zone-ttl 1d;   // 超えるゾーンは読み込まない
    // serial-update-method unixtime;    // Dynamic Update の SOA シリアル: increment | unixtime | date
    // rollback-window 1h;               // karictl rollback のために、リロードやDBインストールで置き換わった直前の版を残す時間 (0 = 残さない)。options / view / zone に書ける
    // check-mx-cname warn;  check-srv-cname ignore;  check-integrity yes;  check-names primary fail;   // karicheck の指摘の重さ (fail | warn | ignore)
    // dnstap の BIND 形式 (dnstap-output は unix だけ):
    // dnstap { auth; };  dnstap-output unix "/var/run/dnstap.sock";  dnstap-identity hostname;
    // catalog-zones { zone "catalog.example"; };   // catalog-zone yes; と同じ

    // UDPソケットバッファサイズ (未指定時のデフォルト: 4M)
    // OSの上限値(kern.ipc.maxsockbuf sysctl)を超えると切り詰められます
    udp-recvbuf-size 4M;
    udp-sndbuf-size 4M;

    // TCP / UDP の転送パラメータ (未指定時は OS 既定値、UDP ペイロード上限は 1232)
    // tcp-window は listen ソケットに設定するため、変更の反映には再起動が必要です
    // tcp-mss は接続確立後に送信 MSS を下げる方向にのみ効きます
    // ゾーン単位の上書き (zone-tcp-mss / zone-tcp-window / zone-tcp-sndbuf /
    // zone-udp-bufsize) と制約は docs/karidns.md の TRANSPORT TUNING を参照
    // tcp-mss 1220;
    // tcp-window 256K;
    // udp-bufsize 1232;

    // Response Rate Limiting (RRL) - DNSリフレクション攻撃対策
    // 指定しない場合はRRLは無効（制限なし）となります
    rate-limit {
        responses-per-second 50;
        nodata-per-second 50;
        nxdomains-per-second 20;
        errors-per-second 10;
        window 15;
        slip 2;
        // log-only yes; // 有効にすると制限はせずログ出力のみ行います
        exempt-clients { 127.0.0.1/32; 192.168.0.0/16; ::1/128; };
    };

    // しきい値アラート (KariDNS 独自、既定は無効)。制御スレッドが interval 秒ごとに
    // カウンタの増分を調べ、しきい値を超えた時に "alert: ..." を一度だけ、下回った時に
    // "alert cleared: ..." を一度だけ syslog (category general) に出す。繰り返しは出さない。
    // zone { alerts { } } で同じ名前をゾーンごとに指定でき、そのゾーンでは options の値より優先される
    // (interval と reload-failures-above は options のみ)。値は karictl stats で確認できる
    // alerts {
    //     interval 60;                      // 検査の間隔 (秒、10..3600)
    //     qps-above 200000;                 // 間隔の平均 QPS
    //     servfail-ratio-above 5;           // 間隔の応答のうち SERVFAIL の割合 (%、100 応答以上のとき)
    //     rrl-drops-above 1000;             // 間隔に rate-limit で破棄した応答数
    //     transfer-failures-above 0;        // 間隔に全プライマリで失敗したセカンダリの更新回数
    //     reload-failures-above 0;          // 間隔に失敗したリロード (ゾーンの読み込み失敗を含む) の回数
    // };
};

logging {
    channel queries_log {
        // ログファイルを開けない場合は起動エラーになる。一般ユーザーで起動する
        // 場合は /var/log ではなく、そのユーザーが書き込めるパスを指定する
        // 容量ベースのローテーション (10MBを超えたらローテーション、3世代保存)
        file "/var/log/named/queries.log" versions 3 size 10M;
        
        // 日付ベース(日次)ローテーションの場合は以下を使用:
        // file "/var/log/named/queries.log" versions 3 suffix timestamp;
        
        print-time yes;
        print-category yes;
        print-severity yes;
    };
    category queries { queries_log; };

    // BIND と同じ書き方で運用メッセージも振り分けられます (docs/karidns.md "logging")。
    // 何も書かなければ、運用メッセージはこれまでどおり syslog (facility daemon) に出ます。
    // channel xfers { file "/var/log/named/xfer.log" versions 5 size 10m; severity info; print-time iso8601-utc; print-category yes; print-severity yes; };
    // channel auth  { syslog auth; severity notice; };
    // category xfer-in { xfers; };  category xfer-out { xfers; };  category notify { xfers; };
    // category security { auth; };
};

// options { querylog yes; };   // クエリログの入切 (BIND と同じ)。書かなければ category queries があるときだけ有効

// BIND の rndc 用 controls は読み込んで検査しますが、効果はありません (制御は karictl と control-channel)。
// controls { inet 127.0.0.1 allow { localhost; } keys { rndc-key; }; };

// karictl コントロールチャネルの設定
// karictlコマンドによる動的リロードやステータス確認を許可する場合に設定します
control-channel {
    // コントロール用UNIXドメインソケットパス (未指定時は /var/run/karidns/control.sock)
    // 一般ユーザーで起動する場合は書き込み可能なディレクトリを指定する
    // (bindできない場合は起動エラーになる)
    // socket "/var/run/karidns/control.sock";
    algorithm "hmac-sha256";
    // karictl.conf側の key "karictl" に設定した secret と一致させてください
    // 下の値はプレースホルダです (このままだと起動エラーになります)。
    // 必ず `openssl rand -base64 32` の出力に置き換えてください
    secret "UkVQTEFDRS1NRTpvcGVuc3NsLXJhbmQtYmFzZTY0LTMy";
};

// 制限付きのキー (control-channel の keys { })。Web 画面などに、状態の確認とゾーン 1 つの reload だけを許す鍵を渡せます。
// 鍵は TSIG と同じトップレベルの key 文で定義し、keys { } で列挙します (上の secret は従来どおり全権の鍵です)。
//   read-only yes          : status / zonestatus / observatory / dbstatus だけ
//   allow-commands { ... } : read-only の鍵に足すコマンド (reload, reload-zone, reconfig, stop, notify, retransfer, rollback)
// 許されないコマンドは ERROR command not allowed for key "<name>" になり、全コマンドが鍵の名前つきで syslog に残ります。
// 制御用の鍵は TSIG と別にしてください (karicheck conf は、TSIG にも使っている鍵を警告します)。
// key "web" { algorithm hmac-sha256; secret "<openssl rand -base64 32 の出力>"; };
// control-channel {
//     keys { "web" read-only yes allow-commands { reload-zone; }; };
//     allow-group "www";   // この group のユーザーも socket に接続できます (socket は group 書き込み可の 0660 になります)。
//                          // Web 用ユーザーは karidns.conf を読めないようにしてください (0640 root:karidns など)。ディレクトリの x 権限は運用側の責任です
// };

// 外部設定ファイルのインクルード (include ディレクティブ)
// トップレベルだけでなく、ブロック内やリストの途中など任意の場所で使用できます。
// 相対パスは options の directory があればそこから、無ければ当設定ファイルの配置ディレクトリを起点に解決されます。
// include "/usr/local/etc/karidns/keys.conf";

// ゾーン転送(AXFR)やNOTIFYで使用するTSIGキー
key "tsig-key-example" {
    algorithm "hmac-sha256";
    // プレースホルダです。`openssl rand -base64 32` の出力に置き換えてください
    // (この鍵を ACL や update-policy で使うと、プレースホルダのままでは起動エラーになります。誰も使わない鍵は警告だけです)
    secret "UkVQTEFDRS1NRTpvcGVuc3NsLXJhbmQtYmFzZTY0LTMy";
};

// 相手サーバーごとの設定 (BIND の server 文)。アドレスまたはプレフィックスで指定し、最も長く一致するものが使われます。
// keys はそのサーバーへの転送要求・更新確認・NOTIFY に署名する鍵です (primaries / also-notify の key が優先、zone の tsig-key より優先)。
// transfer-source / notify-source もこの文が primaries / also-notify の source より優先されます。
// server 192.168.1.100 { keys "tsig-key-example"; transfer-source 192.168.1.1; transfers 1; };
// view の中にも key { } (その view だけで有効。トップレベルと同じ名前は不可) と server { } (書くとトップレベルの server は使われない) を書けます。

// マスターゾーンの定義
zone "example.test" {
    type master;
    file "/usr/local/etc/karidns/zones/example.test.zone";
    allow-transfer { 127.0.0.1; };
};

zone "example.com" {
    type master;
    file "/usr/local/etc/karidns/zones/example.com.zone";
    allow-transfer {
        192.168.1.100;
        // include "acls/common_slaves.conf"; // リスト途中での外部ファイル展開も可能
    };
    also-notify { 192.168.1.100 port 53; };
    // notify-source 192.0.2.1;   // must be an address of this host (the server does not start if it cannot bind it)
    // Dynamic Update を鍵ごとに許す BIND の update-policy (allow-update とは併用できない)。
    // 先頭から最初に一致した規則で決まる。署名された UPDATE だけを受け付ける
    // update-policy { grant tsig-key-example zonesub A AAAA TXT; };
    // セカンダリ側 (type slave) では primaries を複数並べると先頭から順に問い合わせる:
    //   primaries source 192.168.1.1 { 192.168.1.100; 192.168.1.101 key "tsig-key"; };  multi-master yes;
    // ゾーン単位の転送パラメータ (クエリ受信後に接続へ適用。MSS は下げる方向のみ)
    // zone-tcp-sndbuf 2M;       // AXFR など大きな応答の送信バッファ
    // zone-tcp-window 128K;
    // zone-tcp-mss 1200;
    // zone-udp-bufsize 1232;
    
    // 特定のゾーンに対してRRL設定を上書きすることも可能
    // 指定した場合はグローバルオプションより優先されます
    rate-limit {
        responses-per-second 100;
        slip 0; // slipを0にするとTC応答せず即座に破棄します
    };

    // このゾーンだけのアラート (options { alerts { } } で interval が決まる。同じ名前は
    // このゾーンの値が優先され、書かない名前は options の値を使う)
    // alerts {
    //     qps-above 5000;
    //     servfail-ratio-above 1;
    // };
};

// スレーブゾーンの定義
zone "slave.example.net" {
    type slave;
    file "/usr/local/etc/karidns/zones/slave.example.net.zone";
    masters { 10.0.0.1 port 53; };
    tsig-key "tsig-key-example";
    // マスターからの転送を受ける TCP 接続にも適用されます (受信バッファは connect 前に設定)
    // zone-tcp-window 1M;
};
